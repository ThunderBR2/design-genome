{
  "name": "design-genome",
  "version": "0.2.0",
  "description": "Reverse engineering for design: ingest sites, documents, images, videos and Figma files, cross-check every fact with evidence, and give AI agents a verified design genome.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"try{require('fs').chmodSync('dist/cli.js',0o755)}catch{}\"",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "studio": "tsx src/cli.ts studio",
    "mcp": "tsx src/cli.ts mcp",
    "postinstall:browsers": "playwright install chromium"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "culori": "^4.0.2",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.58.2",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "bin": {
    "genome": "dist/cli.js"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "studio"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "design-system",
    "reverse-engineering",
    "design-tokens",
    "mcp",
    "ai",
    "figma",
    "playwright"
  ]
}
